# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Django
db.sqlite3
hub/staticfiles/*
!hub/staticfiles/.gitkeep

# Secrets and generated data
.env
# ANCHORED. Unanchored `data/` matches a directory of that name at ANY depth,
# which silently swallowed hub/benchmarks/data/sweep_summary.csv -- the digest
# the dashboard reads to show what the sweep measured. The file existed locally,
# every test passed, and it would simply have been absent from the deployed
# image, with the curve quietly not rendering. Only the leading slash confines
# this to the generated plant CSVs it was written for.
/data/
!/data/.gitkeep

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/

# Sweep output. The CSV is a build artifact of evaluation/, regenerated by the
# sweep workflow and attached to the run; the article cites a specific run
# rather than whatever happens to be in the working tree.
evaluation/results/
