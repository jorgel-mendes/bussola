# Copy to .env for local development. Never commit the real .env.
SECRET_KEY=dev-only-insecure-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is fine for day-to-day work, but the Sprint 2 concurrency tests need
# Postgres -- select_for_update() is a no-op on SQLite.
# DATABASE_URL=postgres://bussola:bussola@localhost:5432/bussola

# Minimum contributing plants before a benchmark cell may be published.
MIN_CONTRIBUTORS=5

# --- agent (per plant) ---
# BUSSOLA_HUB_URL=http://localhost:8000
# BUSSOLA_TOKEN=<raw token from `seed_demo`>
# BUSSOLA_CONTRIBUTOR_LABEL=plant-01
