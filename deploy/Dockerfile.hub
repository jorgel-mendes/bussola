# Bussola hub
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Dependency layer first so code edits do not invalidate the install.
COPY pyproject.toml uv.lock ./
COPY contracts/pyproject.toml contracts/
COPY agent/pyproject.toml agent/
RUN mkdir -p contracts/bussola_contracts agent/bussola_agent \
 && touch contracts/bussola_contracts/__init__.py agent/bussola_agent/__init__.py \
 && uv sync --frozen --no-dev

COPY . .
RUN uv sync --frozen --no-dev

ENV DJANGO_SETTINGS_MODULE=config.settings.prod \
    PATH="/app/.venv/bin:$PATH"

# Collected at build time so the container starts fast and read-only.
RUN SECRET_KEY=build-only ALLOWED_HOSTS=localhost \
    python hub/manage.py collectstatic --noinput

EXPOSE 8000

# Render sets $PORT; default to 8000 elsewhere.
# Render's free tier has no shell, so first-run setup has to happen at boot.
# bootstrap_deploy is idempotent and env-guarded: it is a no-op unless
# DJANGO_SUPERUSER_* / BUSSOLA_SEED_DEMO are set, and it RAISES rather than
# warning if it was asked to do something and could not. Kept as a management
# command rather than a longer && chain, because Sprint 1's third defect was a
# shell command that grew inside a config file until it silently split.
CMD ["sh", "-c", "python hub/manage.py migrate --noinput && python hub/manage.py bootstrap_deploy && gunicorn config.wsgi:application --chdir hub --bind 0.0.0.0:${PORT:-8000} --workers 2 --timeout 60"]
